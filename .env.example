# Copy to .env in deployment; never commit real values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# Set to 1 ONLY when Django runs behind a TLS-terminating reverse proxy that you
# control and that overwrites X-Forwarded-Proto. Without it, SECURE_SSL_REDIRECT
# causes an endless redirect loop; with it on a direct connection, a client can
# spoof the header and bypass HTTPS.
BEHIND_HTTPS_PROXY=0

# Logging. With no LOG_FILE, records go to stderr (captured by gunicorn/systemd
# or the hosting panel). django.request errors are always logged, so a failed
# payment callback is never lost even when ADMINS is empty.
LOG_LEVEL=INFO
# LOG_FILE=/home/user/logs/rahsadev.log
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_BACKUP_COUNT=3
# LOG_SQL_LEVEL=WARNING

# Database. Local development needs nothing (SQLite). Production supports both
# MySQL/MariaDB (usual on cPanel) and PostgreSQL. URL-encode special characters
# in username/password (for example @ = %40 and # = %23).
# DATABASE_URL=mysql://cpanel_user:password@localhost:3306/cpanel_database
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Keep 0 for shared hosts with a low SQL connection limit; use 60 only when the
# provider explicitly permits persistent connections.
DB_CONN_MAX_AGE=0

# Low-resource profile: use one WSGI process (configured in the hosting panel).
# Keep uploads below the host's memory limit; larger products should use the
# external-download-link option instead of uploading through Django.
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=1048576

# Cache. Default is per-process local memory (fine for dev/single-process).
# For multi-process deployments share rate limits via Redis (built into Django):
# CACHE_URL=redis://127.0.0.1:6379/1

# Email (password reset, newsletter, admin notifications). The easiest way is
# the admin page «تنظیمات ایمیل (SMTP)» — when it is enabled it overrides the
# values below. Otherwise, in development (DEBUG=True) mail is printed to the
# console by default; set EMAIL_BACKEND + SMTP values in production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=FileMarket <no-reply@example.com>

ZARINPAL_MERCHANT_ID=
# Only verified HTTPS API hosts; keep defaults unless the provider documents a change.
ZARINPAL_ALLOWED_HOSTS=api.zarinpal.com,sandbox.zarinpal.com
# Installment gateways — every value can also be set in the admin
# («تنظیمات درگاه‌های پرداخت»); admin values win over these fallbacks.
ZARINPLUS_MERCHANT_TOKEN=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=
# Production API base URL is given by Snapp Pay with your merchant account.
SNAPPAY_BASE_URL=
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_USERNAME=
TOROBPAY_PASSWORD=
# Defaults to https://cpg.torobpay.com
TOROBPAY_BASE_URL=
# Legacy (kept for compatibility, unused by the v2 Torob Pay API).
TOROBPAY_MERCHANT_ID=
# Public site URL used in links inside notification e-mails (e.g. https://example.com).
SITE_URL=
# Send notification e-mail/SMS in a background thread (1) or inline (0).
NOTIFICATIONS_ASYNC=1
# Required only when seed_demo creates its first users with DEBUG=False.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# New ImageField uploads are resized and converted to WebP by default.
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_OPTIMIZATION_MAX_DIMENSION=2000
IMAGE_OPTIMIZATION_WEBP_QUALITY=82
