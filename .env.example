# Copy to .env in deployment; never commit real values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# Set to 1 ONLY when Django runs behind a TLS-terminating reverse proxy that you
# control and that overwrites X-Forwarded-Proto. Without it, SECURE_SSL_REDIRECT
# causes an endless redirect loop; with it on a direct connection, a client can
# spoof the header and bypass HTTPS.
BEHIND_HTTPS_PROXY=0

# Logging. With no LOG_FILE, records go to stderr (captured by gunicorn/systemd
# or the hosting panel). django.request errors are always logged, so a failed
# payment callback is never lost even when ADMINS is empty.
LOG_LEVEL=INFO
# LOG_FILE=/home/user/logs/rahsadev.log
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_BACKUP_COUNT=3
# LOG_SQL_LEVEL=WARNING

ZARINPAL_MERCHANT_ID=
# Only verified HTTPS API hosts; keep defaults unless the provider documents a change.
ZARINPAL_ALLOWED_HOSTS=api.zarinpal.com,sandbox.zarinpal.com
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
TOROBPAY_MERCHANT_ID=
# Required only when seed_demo creates its first users with DEBUG=False.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# New ImageField uploads are resized and converted to WebP by default.
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_OPTIMIZATION_MAX_DIMENSION=2000
IMAGE_OPTIMIZATION_WEBP_QUALITY=82
